{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wstein.github.io/cubacle/schema/v1/fixed-frame-record.schema.json",
  "title": "cubacle fixed-frame record line",
  "description": "Draft, not implemented: one line of the JSON Lines output of cubacle fixed-frame batch. With --certificate the lines form a certificate: a header, the answer records, a summary. Keys are written in the order of properties. See docs/design/fixed-frame-proofs.md.",
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/goal" },
    { "$ref": "#/$defs/distance" },
    { "$ref": "#/$defs/eccentricity" },
    { "$ref": "#/$defs/run" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/summary" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "word": {
      "description": "Moves in canonical spelling: the 18 face turns, separated by single spaces; empty for no move.",
      "type": "string",
      "pattern": "^([URFDLB](2|')?( [URFDLB](2|')?)*)?$"
    },
    "poses": {
      "description": "The eight body poses (pose24.v1), by body id.",
      "type": "object",
      "properties": {
        "poses": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 23 }, "minItems": 8, "maxItems": 8 },
        "stickers": {
          "description": "Full wire state, id-sorted [id, cubie, p, n, up, image]; only when asked for.",
          "type": "array",
          "minItems": 24,
          "maxItems": 24
        }
      },
      "required": ["poses"],
      "additionalProperties": false
    },
    "histogram": {
      "description": "Number of keys at distance 0, 1, 2, ... up to the maximum.",
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 1
    },
    "header": {
      "type": "object",
      "properties": {
        "record": { "const": "header" },
        "format": { "const": "cubacle.fixed-frame" },
        "formatVersion": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/formatVersion" },
        "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
        "gitCommit": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }] },
        "puzzle": { "const": "2x2x2" },
        "frame": { "const": "x=R,y=U,z=F;quarter=-90@outward" },
        "metric": { "const": "htm" },
        "moveOrder": { "const": "U U2 U' R R2 R' F F2 F' D D2 D' L L2 L' B B2 B'" },
        "poseIndex": { "const": "pose24.v1" },
        "key": { "const": "key.v1" },
        "tableEncoding": { "const": "u8-dense-v1" },
        "printSha256": { "$ref": "#/$defs/sha256" },
        "printing": { "description": "The complete print, id-sorted, fields of section 2.2 only.", "type": "array", "minItems": 24, "maxItems": 24 }
      },
      "required": ["record", "format", "formatVersion", "toolVersion", "gitCommit", "puzzle", "frame", "metric", "moveOrder", "poseIndex", "key", "tableEncoding", "printSha256", "printing"],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "record": { "const": "goal" },
        "goalId": { "$ref": "#/$defs/id" },
        "trackedBodies": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 7 }, "uniqueItems": true },
        "keys": { "description": "N_k, the size of the key space.", "type": "integer", "minimum": 1 },
        "goalKeys": { "description": "Keys that meet the display; 0 means unsatisfiable, and then no histogram, eccentricity or table follows.", "type": "integer", "minimum": 0 },
        "deadRules": {
          "description": "Rules that no state can meet at their cell, as [cell index, rule index].",
          "type": "array",
          "items": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }
        },
        "histogram": { "$ref": "#/$defs/histogram" },
        "eccentricity": { "type": "integer", "minimum": 0 },
        "premiseClosed": { "description": "With a premise: whether every goal key also meets the premise.", "type": "boolean" },
        "tableSha256": { "$ref": "#/$defs/sha256" },
        "tableFile": { "description": "Sidecar file name, goal-<tableSha256>.u8, with --tables.", "type": "string", "pattern": "^goal-[0-9a-f]{64}\\.u8$" }
      },
      "required": ["record", "goalId", "trackedBodies", "keys", "goalKeys", "deadRules"],
      "additionalProperties": false
    },
    "distance": {
      "type": "object",
      "properties": {
        "record": { "const": "distance" },
        "id": { "$ref": "#/$defs/id" },
        "goalId": { "$ref": "#/$defs/id" },
        "seed": { "description": "Only for records of a sample request.", "type": "integer", "minimum": 0 },
        "from": { "$ref": "#/$defs/poses" },
        "key": { "type": "integer", "minimum": 0 },
        "distance": { "type": "integer", "minimum": 0 },
        "proven": { "const": true },
        "path": { "$ref": "#/$defs/word" },
        "pathRule": { "const": "lex-least-shortest" },
        "reached": { "$ref": "#/$defs/poses" }
      },
      "required": ["record", "id", "goalId", "from", "key", "distance", "proven", "path", "pathRule", "reached"],
      "additionalProperties": false
    },
    "eccentricity": {
      "type": "object",
      "properties": {
        "record": { "const": "eccentricity" },
        "id": { "$ref": "#/$defs/id" },
        "goalId": { "$ref": "#/$defs/id" },
        "sources": { "description": "Keys that meet the premise.", "type": "integer", "minimum": 0 },
        "histogram": { "$ref": "#/$defs/histogram" },
        "eccentricity": { "type": "integer", "minimum": 0 },
        "witness": {
          "type": "object",
          "properties": {
            "key": { "type": "integer", "minimum": 0 },
            "path": { "$ref": "#/$defs/word" }
          },
          "required": ["key", "path"],
          "additionalProperties": false
        }
      },
      "required": ["record", "id", "goalId", "sources", "histogram", "eccentricity"],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "record": { "const": "run" },
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/poses" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "goalId": { "$ref": "#/$defs/id" },
              "distance": { "type": "integer", "minimum": 0 },
              "path": { "$ref": "#/$defs/word" }
            },
            "required": ["goalId", "distance", "path"],
            "additionalProperties": false
          }
        },
        "closed": { "type": "boolean" },
        "preperiod": { "type": "integer", "minimum": 0 },
        "period": { "type": "integer", "minimum": 1 },
        "maxDistance": { "type": "integer", "minimum": 0 }
      },
      "required": ["record", "id", "from", "steps", "closed", "maxDistance"],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "record": { "const": "error" },
        "line": { "description": "1-based input line number.", "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/id" },
        "code": { "enum": ["invalid_json", "invalid_print", "invalid_state", "unreachable_state", "invalid_display", "unknown_goal", "unsupported", "over_limit"] },
        "message": { "type": "string" }
      },
      "required": ["record", "line", "code", "message"],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "record": { "const": "summary" },
        "records": { "description": "Number of lines before this one.", "type": "integer", "minimum": 1 },
        "chainSha256": { "description": "SHA-256 of all preceding lines as bytes, each with its newline.", "$ref": "#/$defs/sha256" }
      },
      "required": ["record", "records", "chainSha256"],
      "additionalProperties": false
    }
  },
  "examples": [
    { "record": "goal", "goalId": "blank-H-34", "trackedBodies": [1, 3, 6, 7], "keys": 136080, "goalKeys": 3, "deadRules": [], "histogram": [3, 45, 594, 6015, 39849, 79143, 10431], "eccentricity": 6, "tableSha256": "0a3f73e6d95731fe778d47d5a8bdd092d925a3514f2936f60557899d38d81c1c" },
    { "record": "distance", "id": "cex", "goalId": "blank-H-34", "from": { "poses": [5, 19, 7, 12, 2, 17, 23, 11] }, "key": 114083, "distance": 6, "proven": true, "path": "U B R2 B2 U' L", "pathRule": "lex-least-shortest", "reached": { "poses": [2, 4, 14, 17, 18, 8, 23, 11] } }
  ]
}
