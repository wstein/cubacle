{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wstein.github.io/cubacle/schema/v1/gen-definition.schema.json",
  "title": "cubacle pattern definition",
  "description": "What a pattern is: name, cube size, color scheme, sticker grid, color constraints, symmetry, sequence order and orbits. The JSON form of a .gen file; both forms are serializations of one model. Run options are not part of it, see run-options.schema.json. Each JSON key is the camelCase form of the kebab-case key of the text form.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "formatVersion": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/formatVersion" },
    "patternName": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/name" },
    "patternTitle": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/title" },
    "patternAliases": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/aliases" },
    "cubeSize": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/sizes" },
    "colorScheme": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/colorScheme" },
    "colorLetters": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/colorLetters" },
    "stickerGrid": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/faceGrid" },
    "colorConstraints": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/guard" },
    "requiredSymmetry": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/symmetryType" },
    "requiredAntisymmetry": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/symmetryType" },
    "sequenceOrder": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/order" },
    "movableOrbits": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/orbits" },
    "fixedOrbits": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/orbits" },
    "moveAlphabet": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/alphabet" },
    "searchLimits": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/limits" },
    "patternTags": { "$ref": "https://wstein.github.io/cubacle/schema/v1/common.schema.json#/$defs/tags" }
  },
  "required": ["formatVersion", "patternName", "cubeSize", "stickerGrid"],
  "additionalProperties": false,
  "examples": [
    {
      "$schema": "https://wstein.github.io/cubacle/schema/v1/gen-definition.schema.json",
      "formatVersion": 1,
      "patternName": "concentric-squares",
      "cubeSize": 5,
      "colorScheme": "western",
      "stickerGrid": [[["a","b","b","b","a"],["b","b","c","b","b"],["b","c","Z","c","b"],["b","b","c","b","b"],["a","b","b","b","a"]]],
      "colorConstraints": "unique(a*, b*, c*)"
    }
  ]
}
