{
  "$schema": "https://wstein.github.io/cubacle/schema/v1/gen-definition.schema.json",
  "version": 1,
  "name": "concentric-squares",
  "title": "Concentric squares",
  "size": 5,
  "scheme": "western",
  "schema": [
    [
      ["a", "b", "b", "b", "a"],
      ["b", "b", "c", "b", "b"],
      ["b", "c", "Z", "c", "b"],
      ["b", "b", "c", "b", "b"],
      ["a", "b", "b", "b", "a"]
    ]
  ],
  "where": "unique(a*, b*, c*)"
}
